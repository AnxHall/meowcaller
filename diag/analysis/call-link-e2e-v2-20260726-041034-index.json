  "observed": [
    "Creating a video link sends link_create to the call service and receives the opaque token in the typed ACK.",
    "Previewing a link is a link_query operation that returns creator identity, media type, approval state, and whether the querying account is the administrator.",
    "Joining is a separate link_join operation carrying media capabilities.",
    "With approval disabled, link_join returns group_info and the participant joins immediately.",
    "With approval enabled, link_join returns only waiting-room call context and the client begins type=waiting_room heartbeats.",
    "The administrator receives waiting_room_update entries with user state waiting_room_joined.",
    "Denying sends waiting_room_deny and terminates the requester with reason waiting_room_deny.",
    "Admitting sends waiting_room_admit and promotes the requester through an ordinary group_update, relay allocation, and membership rekey.",
    "The link token remains stable while separate active sessions use different call IDs."
  ],
  "not_observed": [
    "A waiting_room_toggle request with enabled=0.",
    "waitingRoomAdmitAll.",
    "Call-link revocation, deletion, or expiration.",
    "An audio-link creation request.",
    "A waiting-room timeout."
  ],
  "hypotheses": [
    "Disabling approval uses the observed waiting_room_toggle shape with enabled=0; this needs a direct capture before treating it as proven.",
    "Audio call links use the same link_create/query/join topology with media=audio and no video child in link_join.",
    "The waiting-room heartbeat keeps the pending request alive and discoverable until admit, deny, timeout, or client departure."
  ]
